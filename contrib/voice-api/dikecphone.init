#!/bin/sh /etc/rc.common
# Template: a voice service (here dikecphone's sipserver) on OpenWrt, under procd.
#   cp dikecphone.init /etc/init.d/dikecphone && chmod 755 /etc/init.d/dikecphone
#   /etc/init.d/mu300-voice enable && /etc/init.d/mu300-voice start
#   /etc/init.d/dikecphone enable && /etc/init.d/dikecphone start
# OpenWrt has no sudo: a service that places or answers calls runs as root (procd's default), as below. One that
# only listens (events, audio pipes) can run as a user in the mu300voice group instead: procd_set_param user/group.
# START after mu300-atd (19) and mu300-voice (95).
START=96
USE_PROCD=1

start_service() {
	procd_open_instance sipserver
	procd_set_param command /opt/dikecphone/sipserver :5060 callforward.local /etc/dikecphone/users.json
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
