#!/bin/sh
# Voice calls: place, answer and follow them, with their audio over the AGDSP path. This is also the local voice
# API other services build on (a SIP server, a dialer): docs/voice-api.md has the contract - the commands and their
# --json output, the events, the hooks, the audio endpoints and who may use which.
#
#   mu300-voice status [--json]                       the calls, and what the audio path is doing
#   mu300-voice call NUMBER [--json] [--demo]         place a call (--demo: then play the melody and echo)
#   mu300-voice answer [ID] [--wait SECONDS] [--json] [--demo]   answer the incoming (or the waiting) call
#   mu300-voice hangup [ID] [--json]                  end every call, or only call ID
#   mu300-voice dtmf DIGITS [--json]                  send tones into the call (0-9 * # A-D)
#   mu300-voice watch                                 follow calls: events, hooks, the audio (the service)
#   mu300-voice events                                print the current state, then every event (JSON lines)
#   mu300-voice audio start [bt|dsp] [--pipes]        put the DSP into the call: scene, profiles, routes, unmute
#   mu300-voice audio stop                            take it out again and put every control it touched back
#   mu300-voice demo | tone [SECONDS] | echo [SECONDS]   on a call that is up: the melody, then echo
#
# "call" and "answer" used to wait for the call and then run the demo by themselves; now they do the one thing
# their name says and return, and --demo (and answer's --wait, or -t) bring the old behaviour back.
#
# Outputs. This board has no speaker, earpiece or microphone, so a call's audio has two places to go:
#
#   bt   a paired Bluetooth headset. The controller's PSKey sends SCO audio over its PCM pins into the audio
#        DSP's IIS3 (g_sys_sco_transmit_mode = 0), so the DSP moves the call between the modem and the headset
#        and the AP only holds the links open: tools/hfp (mu300-hfp) for the headset, the scene here for the DSP.
#        Set BT_HEADSET=<address> in /etc/mu300/voice.conf. This is the route the F50's own Android carries call
#        audio on with the community module (docs/FINDINGS.md 24).
#   dsp  nothing physical: the call's two ends are reachable from the AP instead -
#          playback  hw:<card>,FE_ST_VOICE_PCM_P   what the other side hears
#          capture   hw:<card>,FE_ST_VOICE_C       what they said
#        which is what tone, echo and a SIP bridge use.
#
# How a call is started is from the Rongyue E5's working port of the same DSP (kanoqwq/e5-linux@402fde1,
# @8e9b8a4, @2c726fc - its downlink was heard on the receiver and speaker): the call scene is the hostless
# FE_ST_VOICE, opened in both directions at 8 kHz mono and prepared before either is started; the DSP profiles
# are selected with the value (mode << 24) | (mode << 16) | 5 - param id equal to the mode, low byte the voice DAI
# (5) - before and again after the start; VBC_VOLUME is the voice volume + 1, written raw because the control
# declares a signed maximum of -1 that amixer clamps to; and the downlink is muted while routes change and
# explicitly unmuted after the start (VBC_DL_MUTE and the DAC1 DSP MDG), because a mute the driver caches as off
# is not proof the DSP is unmuted.
#
# The melody is generated here rather than shipped: this repo carries no audio files, and busybox awk has
# sin(), which is all a few notes need.
set -u
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

CONF=${MU300_VOICE_CONF:-/etc/mu300/voice.conf}
BT_HEADSET=
OUTPUT=
VOLUME=6
# the group whose members may read the events and use the audio pipes (docs/voice-api.md); without such a group
# on the system everything below stays root's alone
VOICE_GROUP=mu300voice
# watch: put the DSP into every call (0: events and hooks only), and give it the two audio pipes
WATCH_AUDIO=1
AUDIO_PIPES=0
# call: the only numbers it places (space-separated, exactly as given; "any": every number that is not an emergency
# number); empty: none
CALL_ALLOW=
# voice.conf is shell, read by root: only a file root owns that nobody else may write is read (owner_safe, the same
# test the hooks pass), and one that is missing, unreadable or not root's leaves CALL_ALLOW empty - no call.
# load_conf runs now and again at the moment a call is placed, so a file changed or removed meanwhile counts, never
# what was read at start.
OWNER_UID=${MU300_VOICE_HOOK_UID:-0}
owner_safe() {   # owner_safe PATH: owned by OWNER_UID (root), writable by nobody else
    set -- $(ls -lnd "$1" 2>/dev/null)
    [ "${3:-}" = "$OWNER_UID" ] || return 1
    case $1 in ?????w*|????????w*) return 1 ;; esac
}
load_conf() {
    CALL_ALLOW=
    [ -e "$CONF" ] || return 0
    if ! owner_safe "$CONF"; then
        echo "mu300-voice: $CONF is not root's, or others may change it; not read" >&2
        return 0
    fi
    # shellcheck disable=SC1090
    [ -r "$CONF" ] && . "$CONF"
    case $VOICE_GROUP in [a-z_]*) case $VOICE_GROUP in *[!a-z0-9_-]*) VOICE_GROUP= ;; esac ;; *) VOICE_GROUP= ;; esac
}
load_conf
RATE=${MU300_VOICE_RATE:-8000}
DIR=${MU300_AT_DIR:-/run/mu300-at}
SIM_SLOT=0
if [ -x /opt/mu300/bin/mu300-sim ]; then
    SIM_SLOT=$(/opt/mu300/bin/mu300-sim active) || exit 1
fi
URCLOG=$DIR/urc/stty_nr$((SIM_SLOT * 3)).log
TMP=${MU300_VOICE_TMP:-/run/mu300-voice}
HFP_CTL=/run/mu300-hfp.ctl
ASOUND=${MU300_ASOUND:-/proc/asound}
# The API's files, all in $TMP: the event feed (one JSON object per line), the state a new reader starts from, the
# socket that serves both (tools/voice-events), the audio pipes. The hooks are root's, in /etc.
FEED=$TMP/events.jsonl
FEED_MAX=${MU300_VOICE_FEED_MAX:-16384}
SNAPSHOT=$TMP/state.json
SOCK=$TMP/events.sock
AUDIO_DIR=$TMP/audio
HOOKS=${MU300_VOICE_HOOKS:-/etc/mu300/voice.d}
HOOK_TIMEOUT=${MU300_VOICE_HOOK_TIMEOUT:-30}
# The scene and headset logs live in $TMP as well, and every file is created root-only (umask). Only what the API
# hands out is opened to the group, one file at a time (share), and the directory lets the group in, not list.
umask 077
mkdir -p "$TMP" 2>/dev/null

grp_ok() { [ -n "$VOICE_GROUP" ] && grep -q "^$VOICE_GROUP:" "${MU300_GROUP_FILE:-/etc/group}" 2>/dev/null; }
share() {   # share PATH MODE - MODE with the voice group, or the owner's part of it alone where there is no group
    if grp_ok && chgrp "$VOICE_GROUP" "$1" 2>/dev/null && chmod "$2" "$1" 2>/dev/null; then return 0; fi
    chmod "${2%??}00" "$1" 2>/dev/null
}
share "$TMP" 710

# The sound card is looked for when audio is wanted, not before: calls, events and hooks work without it (a
# kernel without the audio drivers, or before mu300-audio-dsp has bound the card).
card=; VOICE=; PLAY=; CAP=
# by name, not number: the device numbers are not the same on every build of the card
pcmdev() { awk -F': ' -v n="$1 " 'index($2, n) == 1 { split($1, a, "-"); print a[2] + 0; exit }' "$ASOUND/pcm"; }
find_card() {
    [ -n "$card" ] && return 0
    card=$(awk '/sprdphone/ {print $1; exit}' "$ASOUND/cards" 2>/dev/null)
    [ -n "$card" ] || return 1
    VOICE=$(pcmdev FE_ST_VOICE); VOICE=${VOICE:-5}
    PLAY=hw:$card,$(pcmdev FE_ST_VOICE_PCM_P || true)
    CAP=hw:$card,$(pcmdev FE_ST_VOICE_C || true)
    [ "$PLAY" = "hw:$card," ] && PLAY=hw:$card,53
    [ "$CAP" = "hw:$card," ] && CAP=hw:$card,9
    return 0
}
need_card() { find_card || { echo "mu300-voice: the sound card is not registered; run mu300-audio-dsp load" >&2; exit 1; }; }

# a fraction of a second where some sleep can do it (the static busybox next to us can; see mu300-at), else 1 s
bb=${MU300_BUSYBOX:-/opt/mu300/bin/busybox}
nap() {
    if [ -x "$bb" ]; then "$bb" sleep "$1" 2>/dev/null || sleep 1
    else sleep "$1" 2>/dev/null || sleep 1; fi
}

at() { mu300-at -t "${2:-10}" "$1" 2>&1; }
# Phone numbers never reach a log in full: every run of five or more digits (with its +) keeps the two digits after
# a + and its last two, the rest becomes * (+905321234540 -> +90********40). Call history is not kept at all.
mask() {
    awk '{
        out = ""
        while (match($0, /\+?[0-9][0-9][0-9][0-9][0-9]+/)) {
            n = substr($0, RSTART, RLENGTH); keep = (substr(n, 1, 1) == "+") ? 3 : 0
            m = substr(n, 1, keep)
            for (i = keep + 1; i <= length(n) - 2; i++) m = m "*"
            out = out substr($0, 1, RSTART - 1) m substr(n, length(n) - 1)
            $0 = substr($0, RSTART + RLENGTH)
        }
        print out $0
    }'
}
# on stderr: stdout is the commands' answers (--json)
log() { echo "mu300-voice: $*" | mask >&2; }

# --- mixer, with an undo log ---------------------------------------------------------------------------------
# Every control the call touches is read before its first write and put back by "audio stop", so a call leaves
# the card exactly as it found it (the E5 port does the same). Raw controls (profile selects, VBC_VOLUME) go
# through tools/ctlset, which writes the full 32-bit value.
SAVED=$TMP/saved
RAW_CTLS='DSP VBC Profile Select|Audio Structure Profile Select|CVS Profile Select|NXP Profile Select|VBC_VOLUME'
is_raw() { case "|$RAW_CTLS|" in *"|$1|"*) return 0 ;; esac; return 1; }
cget() { amixer -c "$card" cget name="$1" 2>/dev/null | sed -n 's/^ *: values=//p' | tail -1; }
put() {   # put NAME VALUE - a missing control is reported once and skipped: not every build has all of them
    name=$1; val=$2
    if ! awk -v n="$name" 'index($0, n "=") == 1 { f = 1 } END { exit !f }' "$SAVED" 2>/dev/null; then
        old=$(cget "$name")
        if [ -z "$old" ]; then log "no control '$name' on this card, skipped"; return 1; fi
        printf '%s=%s\n' "$name" "$old" >> "$SAVED"
    fi
    if is_raw "$name"; then
        command -v ctlset >/dev/null 2>&1 || { log "'$name' needs tools/ctlset (amixer clamps it)"; return 1; }
        ctlset "$card" "$name" "$val" >/dev/null
    else
        amixer -q -c "$card" cset name="$name" "$val" >/dev/null 2>&1
    fi
}
restore() {
    [ -f "$SAVED" ] || return 0
    find_card || return 0
    # newest first, so a control written twice ends at its oldest value
    sed '1!G;h;$!d' "$SAVED" | while IFS= read -r line; do
        name=${line%%=*}; val=${line#*=}
        if is_raw "$name"; then ctlset "$card" "$name" "$val" >/dev/null 2>&1
        else amixer -q -c "$card" cset name="$name" "$val" >/dev/null 2>&1; fi
    done
    rm -f "$SAVED"
}

# --- the call scene ------------------------------------------------------------------------------------------
# Profile mode by output and bandwidth (audio_structure.xml's order: Handset, Handsfree, Headset4P, Headset3P,
# BTHS, ... each NB1 NB2 WB1 WB2 SWB1 FB1 VOIP1), NB1/WB1/SWB1/FB1 picked by the DSP's bandwidth message.
mode_for() {   # mode_for OUTPUT BAND
    case $1 in
        bt) set -- 28 30 32 33 "$2" ;;      # BTHS
        *)  set -- 0 2 4 5 "$2" ;;          # Handset - the scene needs one, and this board has no device of its own
    esac
    eval "echo \${$(( ${5:-0} + 1 ))}"
}
profiles() {   # profiles OUTPUT
    # the parameter blobs themselves, once per boot: the kernel request_firmware()s them by these names
    # (tools/vbc-profile builds them from a vendor XML set; docs/FINDINGS.md 24)
    if [ ! -f "$TMP/profiles-loaded" ]; then
        for p in audio_structure:'Audio Structure Profile Update' dsp_vbc:'DSP VBC Profile Update' cvs:'CVS Profile Update'; do
            [ -f "/lib/firmware/${p%%:*}" ] || { log "no /lib/firmware/${p%%:*}: the DSP runs the call on its defaults"; continue; }
            amixer -q -c "$card" cset name="${p#*:}" 1 >/dev/null 2>&1
        done
        touch "$TMP/profiles-loaded"
    fi
    band=$(cat "$TMP/band" 2>/dev/null || echo 0)
    mode=$(mode_for "$1" "$band")
    word=$(( (mode << 24) | (mode << 16) | 5 ))
    for p in 'DSP VBC Profile Select' 'Audio Structure Profile Select' 'CVS Profile Select'; do put "$p" "$word"; done
    # the voice volume + 1, which is what the vendor HAL writes
    put VBC_VOLUME $(( ${VOLUME:-6} + 1 ))
    log "profiles: mode $mode (band $band) = $(printf '%#x' "$word"), VBC_VOLUME $(( ${VOLUME:-6} + 1 ))"
}
bt_rate() {
    # the SCO link's rate: 8000 for CVSD, which is all mu300-hfp offers (no codec negotiation)
    put VBC_SRC_BT_DAC "${BT_RATE:-8000}"; put VBC_SRC_BT_ADC "${BT_RATE:-8000}"
}
routes() {   # routes OUTPUT
    # always on in the vendor route (be_switch "opened"): the AP's taps on the call
    put 'S_VOICE_PCM_P SWITCH' 1
    put 'S_VOICE_CAP_C SWITCH' 1
    # Hold the AGDSP power domain for the length of the call. Closing a voice stream runs mcdt_dac_dma_disable,
    # which reads an AGCP register - and if the domain has already dropped by then the read is a bus error and
    # the kernel panics (docs/FINDINGS.md 24b). It is also what lets the AP DMA move at all (kanoqwq/e5-linux
    # FINDINGS 24.2: without it one burst and a stall).
    put agdsp_access_en 1
    case $1 in
        bt)
            # the vendor route for bt_sco: the SoC's IIS0 pins to VBC IIS3 (where the controller's PCM lands), and
            # the voice back ends to Bluetooth
            put SYS_IIS0 vbc_iis3
            put 'S_VOICE_P_BT SWITCH' 1
            put 'S_VOICE_C_BT SWITCH' 1
            bt_rate ;;
        *)
            # the codec back ends: nothing is connected to the codec here, but the scene needs a back end, and
            # this is the one the taps were measured with
            put 'S_VOICE_P_CODEC SWITCH' 1
            put 'S_VOICE_C_CODEC SWITCH' 1
            # VOICE_CAPTURE_DOWNLINK: the capture tap records the far end, not the absent microphone
            put VBC_DSP_VOICE_CAPTURE_TYPE "${MU300_VOICE_CAPTURE_TYPE:-0}"
            # VOICE_PCM_PLAY_UPLINK_ONLY: the far end hears what is played, not a mix with the absent microphone
            put VBC_DSP_VOICE_PCM_PLAY_MODE "${MU300_VOICE_PLAY_MODE:-1}" ;;
    esac
}
mute_dl() { put VBC_DL_MUTE enable; put 'VBC DAC1 DSP MDG Set' 1,1024; }
unmute_dl() { put 'VBC DAC1 DSP MDG Set' 0,1024; put VBC_DL_MUTE disable; log "downlink unmuted"; }

SCENE_PID=$TMP/scene.pid
scene_running() { [ -f "$SCENE_PID" ] && kill -0 "$(cat "$SCENE_PID")" 2>/dev/null; }
audio_start() {   # audio_start OUTPUT [PIPES] - PIPES 1: the two audio pipes as well (output dsp only)
    out=${1:-${OUTPUT:-dsp}}
    case $out in bt|dsp) ;; *) log "no output '$out' (bt or dsp)" >&2; return 2 ;; esac
    find_card || { log "the sound card is not registered; run mu300-audio-dsp load" >&2; return 1; }
    scene_running &&{ log "audio already running ($(cat "$TMP/output" 2>/dev/null))"; return 0; }
    command -v pcmhost >/dev/null 2>&1 || { log "no pcmhost (tools/pcmhost); the call scene cannot start" >&2; return 1; }
    rm -f "$SAVED"
    echo "$out" > "$TMP/output"
    profiles "$out"
    routes "$out"
    mute_dl
    # both directions of the hostless scene, prepared together and then started (pcmhost does that order)
    pcmhost "/dev/snd/pcmC${card}D${VOICE}p,/dev/snd/pcmC${card}D${VOICE}c" "$RATE" 1 0 > "$TMP/scene.log" 2>&1 &
    echo $! > "$SCENE_PID"
    n=0
    while ! grep -q '^started' "$TMP/scene.log" 2>/dev/null; do
        scene_running || { log "the call scene did not start: $(tail -1 "$TMP/scene.log")" >&2; audio_stop; return 1; }
        n=$((n + 1)); [ "$n" -gt 50 ] && { log "the call scene did not start in 5 s" >&2; audio_stop; return 1; }
        nap 0.1
    done
    # the vendor applies the parameters again once both directions run - and the Bluetooth rate again too, which
    # only takes after the scene is RUNNING (kanoqwq/e5-linux FINDINGS 59: set before, the BT side ran 3x slow)
    profiles "$out"
    [ "$out" = bt ] && bt_rate
    unmute_dl
    log "VOICE-RUNNING hw:$card,$VOICE both directions, ${RATE} Hz, output $out"
    [ "${2:-0}" = 1 ] && [ "$out" = dsp ] && pipes_start
    emit "$(printf '{"v":1,"event":"audio","time":%s,"state":"up","audio":%s}' "$(date +%s)" "$(audio_json)")"
    return 0
}
audio_stop() {
    was=
    if [ -f "$SCENE_PID" ]; then
        was=1
        kill "$(cat "$SCENE_PID")" 2>/dev/null
        n=0; while scene_running && [ "$n" -lt 30 ]; do nap 0.1; n=$((n + 1)); done
        rm -f "$SCENE_PID"
    fi
    pipes_stop
    restore
    rm -f "$TMP/output"
    log "VOICE-STOPPED; the controls are back as they were"
    [ -n "$was" ] && emit "$(printf '{"v":1,"event":"audio","time":%s,"state":"down","audio":%s}' "$(date +%s)" "$(audio_json)")"
    return 0
}

# --- the call's audio as two pipes (output dsp) ------------------------------------------------------------------
# For a service that would rather not open ALSA itself: while the scene runs, $AUDIO_DIR/downlink is what the far
# end says and $AUDIO_DIR/uplink is what it hears, raw S16_LE mono at $RATE in 20 ms periods. Each side is an
# arecord/aplay that (re)opens its fifo when a reader or writer comes, so a client may come and go during a call.
# The ALSA devices themselves (status --json: playback, capture) are the other way in, with the least latency; a
# client uses one or the other, since each device takes one stream.
PERIOD=$((160 * RATE / 8000)); BUFFER=$((960 * RATE / 8000))
pipes_start() {
    find_card || return 1
    mkdir -p "$AUDIO_DIR" && share "$AUDIO_DIR" 710
    rm -f "$AUDIO_DIR/downlink" "$AUDIO_DIR/uplink"
    mkfifo "$AUDIO_DIR/downlink" "$AUDIO_DIR/uplink" || { log "audio pipes: mkfifo failed" >&2; return 1; }
    # the group reads the downlink and writes the uplink, and nothing else
    share "$AUDIO_DIR/downlink" 640; share "$AUDIO_DIR/uplink" 620
    (
        while scene_running; do
            arecord -D "$CAP" -t raw -f S16_LE -r "$RATE" -c 1 -q --period-size="$PERIOD" --buffer-size="$BUFFER" \
                > "$AUDIO_DIR/downlink" 2>>"$TMP/pipes.log"
            nap 0.2
        done
    ) &
    echo $! > "$TMP/pipe-down.pid"
    (
        while scene_running; do
            aplay -D "$PLAY" -t raw -f S16_LE -r "$RATE" -c 1 -q --period-size="$PERIOD" --buffer-size="$BUFFER" \
                < "$AUDIO_DIR/uplink" 2>>"$TMP/pipes.log"
            nap 0.2
        done
    ) &
    echo $! > "$TMP/pipe-up.pid"
    log "audio pipes: $AUDIO_DIR/downlink (read), $AUDIO_DIR/uplink (write), S16_LE ${RATE} Hz mono"
}
pipes_stop() {
    for f in "$TMP/pipe-down.pid" "$TMP/pipe-up.pid"; do
        [ -f "$f" ] || continue
        p=$(cat "$f")
        # the arecord/aplay first (or the shell blocked opening the fifo for one), then the loop, then a child it
        # may have started in between
        pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; pkill -P "$p" 2>/dev/null
        rm -f "$f"
    done
    rm -rf "$AUDIO_DIR"
}
audio_json() {   # the audio part of status --json and of the audio events
    if find_card; then
        if scene_running; then
            o=$(cat "$TMP/output" 2>/dev/null); case $o in bt|dsp) ;; *) o=dsp ;; esac
            running=true; o="\"$o\""
        else running=false; o=null; fi
        pipes=null
        [ -p "$AUDIO_DIR/downlink" ] && pipes="{\"downlink\":\"$AUDIO_DIR/downlink\",\"uplink\":\"$AUDIO_DIR/uplink\"}"
        printf '{"available":true,"running":%s,"output":%s,"format":"S16_LE","rate":%s,"channels":1,"period_frames":%s,"playback":"%s","capture":"%s","pipes":%s}' \
            "$running" "$o" "$RATE" "$PERIOD" "$PLAY" "$CAP" "$pipes"
    else
        printf '{"available":false,"running":false,"output":null,"format":"S16_LE","rate":%s,"channels":1,"period_frames":%s,"playback":null,"capture":null,"pipes":null}' \
            "$RATE" "$PERIOD"
    fi
}

# The DSP says which bandwidth the network gave the call (NB/WB/SWB/FB) on the voice pipe: 20 bytes, u16 command,
# u16 channel, four u32. Command 0 on channel 2 is the network message, its second parameter the bandwidth
# (kanoqwq/e5-linux@402fde1). The profile follows it.
PIPE_PID=$TMP/pipe.pid
pipe_watch() {
    [ -c /dev/audio_pipe_voice ] || return 0
    (
        while :; do
            set -- $(dd if=/dev/audio_pipe_voice bs=20 count=1 2>/dev/null | od -An -tu4)
            [ $# -ge 3 ] || { sleep 1; continue; }
            cmd=$(( $1 & 0xffff )); ch=$(( $1 >> 16 ))
            if [ "$cmd" = 0 ] && [ "$ch" = 2 ] && [ "$3" -le 3 ]; then
                echo "$3" > "$TMP/band"
                log "DSP: network bandwidth $3"
                if scene_running; then profiles "$(cat "$TMP/output")"; unmute_dl; fi
            else
                log "DSP: cmd $(printf '%#x' "$cmd") channel $ch params $2 $3"
            fi
        done
    ) &
    echo $! > "$PIPE_PID"
}

# --- the Bluetooth headset -----------------------------------------------------------------------------------
HFP_PID=$TMP/hfp.pid
hfp_up() { [ -f "$HFP_PID" ] && kill -0 "$(cat "$HFP_PID")" 2>/dev/null && [ -p "$HFP_CTL" ]; }
hfp() { hfp_up && echo "$*" > "$HFP_CTL"; }
hfp_connect() {
    [ -n "$BT_HEADSET" ] || return 1
    hfp_up && return 0
    command -v mu300-hfp >/dev/null 2>&1 || { log "no mu300-hfp (tools/hfp)"; return 1; }
    mu300-hfp -C "$HFP_CTL" -a "mu300-at ATA" -x "mu300-at AT+CHUP" "$BT_HEADSET" > "$TMP/hfp.log" 2>&1 &
    echo $! > "$HFP_PID"
    n=0
    while ! grep -q 'service level connection up' "$TMP/hfp.log" 2>/dev/null; do
        kill -0 "$(cat "$HFP_PID")" 2>/dev/null || { log "headset $BT_HEADSET: $(tail -1 "$TMP/hfp.log")"; rm -f "$HFP_PID"; return 1; }
        n=$((n + 1)); [ "$n" -gt 100 ] && { log "headset $BT_HEADSET: no service level connection in 10 s"; hfp_disconnect; return 1; }
        sleep 0.1
    done
    log "headset $BT_HEADSET connected"
}
hfp_disconnect() {
    [ -f "$HFP_PID" ] || return 0
    hfp quit 2>/dev/null; sleep 0.5
    kill "$(cat "$HFP_PID")" 2>/dev/null; rm -f "$HFP_PID"
}

# --- following calls -----------------------------------------------------------------------------------------
# +CLCC: <id>,<dir>,<stat>,<mode>,<mpty>[,<number>,<type>...] with stat 0 active, 1 held, 2 dialling, 3 alerting,
# 4 incoming, 5 waiting. clcc_parse turns a reply into one line per voice call (mode 0; data and fax are not ours):
#   ID DIR STATE MPTY NUMBER     e.g. "1 in incoming 0 +905321234540" - DIR in|out, MPTY 0|1, NUMBER - when hidden
# The number keeps only what a number has (digits, + * #), at most 32 of them: it goes into JSON, into the hooks'
# environment and into AT commands, and the modem's text is not trusted to be a number.
clcc_parse() {
    awk -F, '/^\+CLCC:/ {
        sub(/^\+CLCC: */, "")
        if ($4 + 0 != 0) next
        split("active held dialing alerting incoming waiting", S, " ")
        st = $3; gsub(/ /, "", st)
        state = (st ~ /^[0-5]$/) ? S[st + 1] : "unknown"
        num = $6; gsub(/[^0-9+*#]/, "", num); if (num == "") num = "-"
        print $1 + 0, ($2 + 0 == 1 ? "in" : "out"), state, ($5 + 0 == 1 ? 1 : 0), substr(num, 1, 32)
    }'
}
calls=
read_calls() {   # read_calls -> $calls (clcc_parse lines); false when the modem did not answer
    r=$(at 'AT+CLCC' 8)
    printf '%s\n' "$r" | grep -q '^OK' || return 1
    calls=$(printf '%s\n' "$r" | clcc_parse)
    return 0
}
calls_json() {   # calls_json LINES -> a JSON array of calls
    printf '%s\n' "$1" | awk 'BEGIN { printf "[" }
        NF >= 5 { printf "%s{\"id\":%d,\"dir\":\"%s\",\"state\":\"%s\",\"number\":%s,\"multiparty\":%s}", (n++ ? "," : ""),
                  $1, $2, $3, ($5 == "-" ? "null" : "\"" $5 "\""), ($4 == 1 ? "true" : "false") }
        END { printf "]" }'
}
status_json() {   # status_json EVENT TIME MODEM-OK - the calls in $calls
    sock=false; [ -S "$SOCK" ] && sock=true
    printf '{"v":1,"event":"%s","time":%s,"modem":%s,"calls":%s,"audio":%s,"api":{"socket":"%s","socket_up":%s,"feed":"%s","hooks":"%s"}}\n' \
        "$1" "$2" "$3" "$(calls_json "$calls")" "$(audio_json)" "$SOCK" "$sock" "$FEED" "$HOOKS"
}

# --- the events ------------------------------------------------------------------------------------------------
# Every event is one line of JSON appended to $FEED (in RAM, the group may read it, at most $FEED_MAX bytes: when
# full it moves to $FEED.1 and a new one starts) - the API's record of what happened, not a log, so the numbers
# are in it in full; the logs never have them. tools/voice-events serves the feed on $SOCK, starting each reader
# with $SNAPSHOT (status --json as of the last change).
emit() {
    if [ ! -f "$FEED" ] || [ "$(wc -c < "$FEED")" -ge "$FEED_MAX" ]; then
        [ -f "$FEED" ] && mv -f "$FEED" "$FEED.1"
        : > "$FEED"; share "$FEED" 640
    fi
    printf '%s\n' "$1" >> "$FEED"
}
snapshot() {   # snapshot MODEM-OK - rewrite $SNAPSHOT when something in it changed
    s=$(status_json snapshot 0 "$1")
    [ "$s" = "${SNAP_LAST:-}" ] && return 0
    SNAP_LAST=$s
    status_json snapshot "$(date +%s)" "$1" > "$SNAPSHOT.new" && share "$SNAPSHOT.new" 640 && mv -f "$SNAPSHOT.new" "$SNAPSHOT"
}
EV_PID=$TMP/events.pid
events_up() { [ -f "$EV_PID" ] && kill -0 "$(cat "$EV_PID")" 2>/dev/null; }
events_start() {
    events_up && return 0
    command -v mu300-voice-events >/dev/null 2>&1 || return 1
    grp=; grp_ok && grp=$VOICE_GROUP
    mu300-voice-events "$SOCK" "$FEED" "$SNAPSHOT" $grp >> "$TMP/events-server.log" 2>&1 &
    echo $! > "$EV_PID"
}
events_stop() { events_up && kill "$(cat "$EV_PID")" 2>/dev/null; rm -f "$EV_PID" "$SOCK"; }

# The hooks: every executable /etc/mu300/voice.d/*.sh, in name order, once per call event, as root - so only
# files root owns and nobody else may change are run (the directory too), each with stdin, stdout and stderr on
# /dev/null and at most HOOK_TIMEOUT seconds. Their environment: CALL_EVENT=call, CALL_STATE, CALL_PREV_STATE,
# CALL_ID, CALL_DIR, NUMBER (and CALL_NUMBER; empty when hidden), CALL_JSON (the event's line). One event's hooks
# run after the last event's have finished, in the background: a slow hook delays the next hook, never the watch.
# The directory and each hook are checked again at every run (hook_safe = owner_safe), never once at start: a
# directory opened up after the watch began stops the hooks from then on.
HOOK_SEQ=0
hook_safe() { owner_safe "$1"; }
run_hooks() {   # run_hooks STATE PREV ID DIR NUMBER JSON
    [ -d "$HOOKS" ] || return 0
    HOOK_SEQ=$((HOOK_SEQ + 1))
    (
        seq=$HOOK_SEQ; n=0
        while [ "$(cat "$TMP/hooks.done" 2>/dev/null)" != $((seq - 1)) ] && [ "$n" -lt 1200 ]; do nap 0.1; n=$((n + 1)); done
        if hook_safe "$HOOKS"; then
            to=; command -v timeout >/dev/null 2>&1 && to="timeout $HOOK_TIMEOUT"
            for h in "$HOOKS"/*.sh; do
                [ -f "$h" ] && [ -x "$h" ] || continue
                hook_safe "$h" || { log "hook ${h##*/} not run: not root's, or others may change it"; continue; }
                CALL_EVENT=call CALL_STATE=$1 CALL_PREV_STATE=$2 CALL_ID=$3 CALL_DIR=$4 NUMBER=$5 CALL_NUMBER=$5 \
                    CALL_JSON=$6 $to "$h" </dev/null >/dev/null 2>&1
                rc=$?; [ "$rc" = 0 ] || log "hook ${h##*/}: exit $rc"
            done
        else
            log "hooks: $HOOKS is not root's, or others may change it; none run"
        fi
        echo "$seq" > "$TMP/hooks.done"
    ) &
}
call_event() {   # call_event STATE PREV ID DIR NUMBER MPTY
    num=null; [ "$5" != - ] && num="\"$5\""
    mp=false; [ "$6" = 1 ] && mp=true
    j=$(printf '{"v":1,"event":"call","time":%s,"id":%s,"state":"%s","prev":"%s","dir":"%s","number":%s,"multiparty":%s}' \
        "$(date +%s)" "$3" "$1" "$2" "$4" "$num" "$mp")
    emit "$j"
    log "call $3 ($4): $2 -> $1$([ "$5" != - ] && echo " $5")"
    run_hooks "$1" "$2" "$3" "$4" "${5#-}" "$j"
}
diff_calls() {   # diff_calls BEFORE NOW - an event for each call that is new, changed state or has gone
    while read -r id dir st mp num; do
        [ -n "$id" ] || continue
        old=$(printf '%s\n' "$1" | awk -v i="$id" '$1 == i { print $3; exit }')
        [ "$old" = "$st" ] || call_event "$st" "${old:-none}" "$id" "$dir" "$num" "$mp"
    done <<EOF
$2
EOF
    while read -r id dir st mp num; do
        [ -n "$id" ] || continue
        printf '%s\n' "$2" | awk -v i="$id" '$1 == i { f = 1 } END { exit !f }' && continue
        call_event ended "$st" "$id" "$dir" "$num" "$mp"
    done <<EOF
$1
EOF
}

# Until the next round: POLL seconds with a call (1), IDLE_POLL without (3) - and at once when the modem says
# something on nr0 (RING, +CLIP, NO CARRIER...), which mu300-atd writes to $URCLOG: an incoming call is seen within
# a tick, without asking the modem every second all day.
urc_sig() { { wc -c < "$URCLOG"; } 2>/dev/null || echo 0; }
wait_round() {
    w=${MU300_VOICE_POLL:-1}; [ -z "$calls" ] && w=${MU300_VOICE_IDLE_POLL:-3}
    tick=${MU300_VOICE_TICK:-0.25}
    sig=$(urc_sig); i=0
    while [ "$i" -lt $((w * 4)) ]; do
        nap "$tick"
        [ "$(urc_sig)" != "$sig" ] && break
        i=$((i + 1))
    done
}

# Follow the calls: an event (feed, socket, hooks) for every change, the DSP and the headset by the first call's
# state. This never places, answers or ends a call by itself; only the headset's own buttons do, when pressed.
# One watch at a time ($TMP/watch.pid): a second one would emit every event twice.
WATCH_PID=$TMP/watch.pid
watch_up() { [ -f "$WATCH_PID" ] && [ "$(cat "$WATCH_PID")" != $$ ] && kill -0 "$(cat "$WATCH_PID")" 2>/dev/null; }
watch_exit() {
    scene_running && audio_stop
    hfp_disconnect
    [ -f "$PIPE_PID" ] && kill "$(cat "$PIPE_PID")" 2>/dev/null
    events_stop
    rm -f "$WATCH_PID"
    exit 0
}
watch() {
    watch_up && { echo "mu300-voice: already watching (pid $(cat "$WATCH_PID"))" >&2; exit 1; }
    echo $$ > "$WATCH_PID"
    echo 0 > "$TMP/hooks.done"
    [ "$WATCH_AUDIO" = 1 ] && pipe_watch
    trap watch_exit INT TERM
    events_start || log "no mu300-voice-events (tools/voice-events): no event socket; the events are in $FEED"
    log "watching calls (output ${OUTPUT:-auto}, headset ${BT_HEADSET:-none}, audio $([ "$WATCH_AUDIO" = 1 ] && echo on || echo off))"
    # caller id on nr0 (+CLIP), which also wakes wait_round for a ring
    at 'AT+CLIP=1' 8 >/dev/null
    prev=; last=; ring=0; failed=; rounds=0
    while :; do
        if read_calls; then
            diff_calls "$prev" "$calls"
            prev=$calls
            # the first call drives the audio (awk, not "set -- $calls": a number like *100# would be a glob)
            stat=$(printf '%s\n' "$calls" | awk 'NF { print $3; exit }')
            number=$(printf '%s\n' "$calls" | awk 'NF { print $5; exit }')
            case $stat in
                active|held|dialing|alerting)
                    if [ "$WATCH_AUDIO" = 1 ] && [ -z "$failed" ] && ! scene_running && find_card; then
                        out=${OUTPUT:-}
                        [ -z "$out" ] && { [ -n "$BT_HEADSET" ] && out=bt || out=dsp; }
                        if [ "$out" = bt ] && ! hfp_connect; then out=dsp; fi
                        # once per call: a scene that will not start is not retried every second
                        audio_start "$out" "$AUDIO_PIPES" || failed=1
                    fi
                    if [ "$(cat "$TMP/output" 2>/dev/null)" = bt ]; then
                        case $stat in dialing) hfp setup 2 ;; alerting) hfp setup 3 ;; *) hfp call 1; hfp setup 0 ;; esac
                        hfp sco on
                    fi ;;
                incoming|waiting)
                    if [ "$WATCH_AUDIO" = 1 ] && [ -n "$BT_HEADSET" ] && hfp_connect; then
                        hfp setup 1
                        now=$(date +%s); [ $((now - ring)) -ge 3 ] && { hfp "ring ${number#-}"; ring=$now; }
                    fi ;;
                *)
                    failed=
                    if [ -n "$last" ]; then
                        scene_running && audio_stop
                        hfp sco off; hfp call 0; hfp setup 0
                        hfp_disconnect
                    fi ;;
            esac
            last=$stat
            snapshot true
        else
            # no answer is not "no call": nothing changes until the modem answers again
            snapshot false
        fi
        events_up || events_start
        rounds=$((rounds + 1))
        [ -n "${MU300_VOICE_ROUNDS:-}" ] && [ "$rounds" -ge "$MU300_VOICE_ROUNDS" ] && break
        wait_round
    done
    # (tests) let the last hooks finish
    n=0; while [ "$(cat "$TMP/hooks.done" 2>/dev/null)" != "$HOOK_SEQ" ] && [ "$n" -lt 100 ]; do nap 0.1; n=$((n + 1)); done
    watch_exit
}

# --- the AP's taps on a call (output dsp) ----------------------------------------------------------------------
# A melody, as raw S16_LE mono at $RATE. Two voices and a slow decay, so it sounds like something rather than
# a test tone - the point is for a human on the other end to recognise it instantly as "the device is playing
# me music", not to be pretty.
melody() {
    awk -v rate="$RATE" 'BEGIN {
        n = split("523,0.4 659,0.4 784,0.4 1047,0.8 784,0.4 659,0.4 523,0.8 587,0.4 " \
                  "698,0.4 880,0.4 1175,0.8 880,0.4 698,0.4 587,0.8", notes, " ")
        pi = 3.14159265358979
        for (i = 1; i <= n; i++) {
            split(notes[i], p, ",")
            f = p[1] + 0; dur = p[2] + 0
            samples = int(rate * dur)
            for (s = 0; s < samples; s++) {
                t = s / rate
                env = 1 - (s / samples)          # decay, so the notes are separate
                env = env * env
                v = sin(2 * pi * f * t) * 0.55 + sin(2 * pi * f * 0.5 * t) * 0.2
                a = int(v * env * 11000)
                if (a < 0) a += 65536            # two.s complement, little endian
                printf "%c%c", a % 256, int(a / 256) % 256
            }
        }
    }'
}

# The call scene is the DSP's, and it consumes in fixed frames. aplay left to itself picks a buffer from what
# the driver advertises (up to 116720 frames) and the write then fails with a bare "I/O error" - which says
# nothing about periods and sent me looking at routes and firmware instead. 20 ms at the call's rate is what
# the vendor HAL uses. The rest of the list is there because the first one is a guess about hardware nobody
# documented: whichever works, works, and voice_play says which.
# These are AP DMA streams, so they need the period timer of kernel/patches/audio-pcm-period-timer.patch: the
# DMA completion interrupt never arrives on this SoC, and without it every one stops after its first buffer.
PERIODS="160,960 320,1920 0,0"
voice_play() {   # voice_play FILE -> play it into the call, trying each framing until one takes
    f=$1
    for p in $PERIODS; do
        ps=${p%,*}; bs=${p#*,}
        if [ "$ps" = 0 ]; then
            err=$(aplay -D "$PLAY" -f S16_LE -r "$RATE" -c 1 -q "$f" 2>&1)
        else
            # scale the framing if the rate is not the 8k these numbers were written for
            ps=$((ps * RATE / 8000)); bs=$((bs * RATE / 8000))
            err=$(aplay -D "$PLAY" -f S16_LE -r "$RATE" -c 1 -q \
                  --period-size="$ps" --buffer-size="$bs" "$f" 2>&1)
        fi
        [ -z "$err" ] && { echo "$ps,$bs" > "$TMP/framing"; return 0; }
        last=$err
    done
    echo "mu300-voice: nothing played - last error: $(echo "$last" | head -1)" >&2
    return 1
}

tone() {
    f=$TMP/melody.raw
    [ -s "$f" ] || melody > "$f"
    reps=${1:-1}
    i=0
    while [ "$i" -lt "$reps" ]; do
        voice_play "$f" || return 1
        i=$((i + 1))
    done
    [ -f "$TMP/framing" ] && echo "played at period,buffer = $(cat "$TMP/framing")"
}

# Record a slice and hand it straight back, for ever. The caller hears themselves one slice late, which is the
# clearest proof there is that both directions of the call carry audio: uplink and downlink at once, from one
# test, with no second device involved.
echo_loop() {
    secs=${1:-5}
    echo "echoing every ${secs}s - ^C to stop" >&2
    while :; do
        arecord -D "$CAP" -f S16_LE -r "$RATE" -c 1 -d "$secs" -q \
                --period-size=$((160 * RATE / 8000)) --buffer-size=$((960 * RATE / 8000)) \
                "$TMP/echo.raw" 2>"$TMP/cap.err" || {
            echo "mu300-voice: capture failed: $(head -1 "$TMP/cap.err")" >&2; return 1; }
        voice_play "$TMP/echo.raw" || return 1
    done
}

in_call() { at 'AT+CLCC' 8 | grep -q '^+CLCC:'; }

demo() {
    scene_running || audio_start dsp
    echo "playing the melody..."
    tone 2
    echo "now echoing you back every ${1:-5}s"
    echo_loop "${1:-5}"
}

# --- the commands ----------------------------------------------------------------------------------------------
usage() { grep '^#   mu300-voice ' "$0" | sed 's/^# \{0,3\}//' >&2; exit 2; }
# The options of the call commands, in any order: --json, --demo, --wait SECONDS (-t), and one ID or NUMBER.
JSON=0; DEMO=0; WAIT=; ARG=
opts() {
    while [ $# -gt 0 ]; do
        case $1 in
            --json) JSON=1 ;;
            --demo) DEMO=1 ;;
            --wait|-t) [ $# -ge 2 ] || usage; WAIT=$2; shift ;;
            -*) usage ;;
            *) [ -z "$ARG" ] || usage; ARG=$1 ;;
        esac
        shift
    done
    case $WAIT in ''|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) ;; *) usage ;; esac
}
# result ACTION true|false [ERROR] [EXTRA-JSON] - the answer of a call command: one JSON line with --json, the
# error alone on stderr without; the exit status says the same. ERROR is ours or the modem's result code, never
# free text from elsewhere, and EXTRA starts with a comma.
result() {
    if [ "$JSON" = 1 ]; then
        if [ "$2" = true ]; then printf '{"v":1,"action":"%s","ok":true%s}\n' "$1" "${4:-}"
        else printf '{"v":1,"action":"%s","ok":false,"error":"%s"%s}\n' "$1" "$3" "${4:-}"; fi
    elif [ "$2" != true ]; then
        echo "mu300-voice: $1: $3" | mask >&2
    fi
    [ "$2" = true ] && return 0
    exit 1
}
# the final result of a modem reply, as an error: "+CME ERROR: 30", "NO CARRIER"; else what mu300-at said instead
# ("mu300-at: busy", "mu300-at: needs root"), up to its first parenthesis or semicolon; else that there was nothing
modem_error() {
    e=$(printf '%s\n' "$1" | grep -E '^(ERROR|\+CME ERROR|\+CMS ERROR|NO CARRIER|BUSY|NO ANSWER|NO DIALTONE)' | head -1 |
        tr -cd 'A-Za-z0-9 +:_.-')
    [ -n "$e" ] || e=$(printf '%s\n' "$1" | grep '^mu300-at: ' | head -1 | sed 's/[(;].*//; s/ *$//' | tr -cd 'A-Za-z0-9 +:_.-')
    echo "${e:-no answer from the modem}"
}
is_id() { case $1 in [1-9]) return 0 ;; esac; return 1; }
# Only a call's own id (1-9) reaches AT+CHLD, only 0-9 * # A-D reach AT+VTS, and only a number - digits with at
# most a leading +, 3 to 20 of them - reaches ATD: anything else would be sent to the modem as it is, and
# "ATD1;+CFUN=0" is two commands. No * or # in a number: those are MMI/USSD codes, not calls (tones go by dtmf).
# Each value is checked exactly as it is put into the command; nothing is normalised after the check.
valid_number() {
    case $1 in ''|*[!0-9+]*|?*+*|+) return 1 ;; esac
    [ ${#1} -ge 3 ] && [ ${#1} -le 20 ]
}
# What "call" may dial, in three layers, each failing closed - a check that cannot run refuses the call:
#  1. valid_number (above): the exact string ATD gets is ASCII digits with at most a leading +, 3-20 of them. No
#     spaces, dashes or brackets, no *31#, #31#, *67 or any other * # code, no ";" or suffix, no non-ASCII digits:
#     refused, never cleaned up - so there is no other spelling of the number left to normalise.
#  2. CALL_ALLOW (voice.conf): the numbers this device may call, exactly as written there, space-separated. Empty,
#     or no voice.conf: nothing is called. "any" lifts this layer (the next one stays).
#  3. emergency numbers, never: a script or a remote SIP client must not be able to call them, and a modem places
#     them even without a SIM. The list is a fixed one (the common ones world-wide and Turkey's) plus the network's
#     (+CEN2) and the SIM's (EF_ECC), read from the modem on every call - and when the modem does not give them (no
#     answer, ERROR, a SIM status that is neither "here it is" nor "there is none") the call is refused. A number is
#     refused when it is on the list as dialled, or after a + / 00 / 0 prefix and up to three digits of country or
#     trunk code, with or without a national 0 ("+90112", "0090112", "090112", "0112"). A short ordinary number
#     that ends like one is refused too; layer 2 is the real gate.
EMERGENCY='112 911 999 000 08 110 118 119 100 101 102 103 104 105 106 108 122 155 156 157 158 177 184 061 15 17 18'
crsm() {   # crsm COMMAND -> "SW1 SW2 DATA" (DATA may be empty); false when the modem gave no +CRSM line
    printf '%s\n' "$(at "$1" 5)" |
        sed -n 's/^+CRSM: *\([0-9][0-9]*\) *, *\([0-9][0-9]*\) *,\{0,1\} *"\{0,1\}\([0-9A-Fa-f]*\)"\{0,1\}.*/\1 \2 \3/p' |
        grep -m1 .
}
ecc_digits() {   # ecc_digits HEX STEP -> the BCD numbers in HEX (3 bytes each, nibbles swapped, F-padded)
    printf '%s\n' "$1" | awk -v step="$2" '{
        s = toupper($0); n = length(s)
        for (o = 1; o + 5 <= n; o += step) {
            d = ""
            for (i = o; i < o + 6; i += 2) {
                lo = substr(s, i + 1, 1); hi = substr(s, i, 1)
                if (lo == "F") break; d = d lo
                if (hi == "F") break; d = d hi
            }
            if (d ~ /^[0-9]+$/) print d
        }
    }'
}
emergency_lists() {   # the network's and the SIM's emergency numbers, one per line; false when either is not known
    # +CEN2: <category>,<number> (27.007 10.1.62); the reply must end in OK and carry the list (+CEN1 heads it even
    # when it is empty) - a bare OK is a modem that did not answer the question, not an empty list
    r=$(at 'AT+CEN?' 5)
    printf '%s\n' "$r" | grep -q '^OK' || return 1
    printf '%s\n' "$r" | grep -q '^+CEN[12]:' || return 1
    printf '%s\n' "$r" | sed -n 's/^+CEN2: *[0-9]* *, *"\{0,1\}\([0-9]*\)"\{0,1\}.*/\1/p'
    # EF_ECC (6FB7): on a USIM linear fixed, one number per record (the record's first 3 bytes), read until the SIM
    # says there is no further record; on a 2G SIM transparent, a run of 3-byte numbers
    rec=1
    while [ "$rec" -le 20 ]; do
        sw=$(crsm "AT+CRSM=178,28599,$rec,4,0") || return 1
        set -- $sw
        case ${1:-}/${2:-} in
            144/*) ecc_digits "${3:-}" 100000 ;;
            106/131|106/130|148/4) return 0 ;;     # no further record / no such file: the list is complete
            105/*|103/*)                           # not a record file: a 2G SIM's transparent EF_ECC
                sw=$(crsm 'AT+CRSM=176,28599,0,0,0') || return 1
                set -- $sw
                case ${1:-}/${2:-} in
                    144/*) ecc_digits "${3:-}" 6; return 0 ;;
                    106/130|148/4) return 0 ;;
                esac
                return 1 ;;
            *) return 1 ;;
        esac
        rec=$((rec + 1))
    done
    return 0
}
in_list() {   # in_list NUMBER LIST
    for e in $2; do case $1 in "$e"|"0$e") return 0 ;; esac; done
    case $1 in +*) d=${1#+} ;; 00*) d=${1#00} ;; 0*) d=${1#0} ;; *) return 1 ;; esac
    # up to three digits of country or trunk code, taken off one at a time (no external tool that could fail)
    for cc in 0 1 2 3; do
        for e in $2; do case $d in "$e"|"0$e") return 0 ;; esac; done
        d=${d#?}
        [ -n "$d" ] || break
    done
    return 1
}
is_emergency() {   # is_emergency NUMBER: 0 an emergency number, 1 not, 2 the modem's lists could not be read
    # Nothing is cached: the fixed list is applied first, whatever the modem does, and the modem's lists are read
    # afresh for every call - an earlier successful read is never used in place of one that fails now.
    in_list "$1" "$EMERGENCY" && return 0
    l=$(emergency_lists) || return 2
    in_list "$1" "$(printf '%s\n' "$l" | tr '\n' ' ')" && return 0
    return 1
}
call_allowed() {   # call_allowed NUMBER: in CALL_ALLOW, or CALL_ALLOW=any; nothing configured is nothing allowed
    case " ${CALL_ALLOW:-} " in *" any "*|*" $1 "*) return 0 ;; esac
    return 1
}
# Through sudo (the mu300voice group's way in, contrib/voice-api/sudoers.mu300voice) only the API's own grammar is
# accepted, whatever the sudoers wildcards let through: status --json, call NUMBER, answer [ID] [--wait S],
# hangup [ID], dtmf DIGITS - no --demo (the audio test, which plays into the call and loops), no audio, watch,
# demo, tone or echo. sudo has already reset the environment (no MU300_* variable, no other voice.conf).
api_only() {
    [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != root ] || return 0
    case $cmd in status|call|answer|hangup|dtmf) ;; *) echo "mu300-voice: through sudo only status, call, answer, hangup and dtmf" >&2; exit 2 ;; esac
    [ "$DEMO" = 0 ] || { echo "mu300-voice: through sudo no --demo" >&2; exit 2; }
}
# Leave the DSP to watch where it runs; a command on its own stops the scene once no call is left.
audio_after_hangup() {
    watch_up && return 0
    scene_running || return 0
    read_calls && [ -z "$calls" ] && audio_stop >/dev/null
}

cmd=${1:-status}
[ $# -gt 0 ] && shift
api_only
case $cmd in
audio)
    case "${1:-}" in
        start)
            out=; pipes=0
            shift
            for a in "$@"; do case $a in --pipes) pipes=1 ;; bt|dsp) out=$a ;; *) usage ;; esac; done
            audio_start "$out" "$pipes" ;;
        stop) audio_stop ;;
        *) usage ;;
    esac ;;

watch) watch ;;

events)
    # what a reader of the socket gets, for a reader without one: the state, then each event as it comes
    cat "$SNAPSHOT" 2>/dev/null || { read_calls && status_json snapshot "$(date +%s)" true; }
    [ -f "$FEED" ] || { : > "$FEED" 2>/dev/null && share "$FEED" 640; }
    exec tail -n 0 -F "$FEED" 2>/dev/null ;;

status)
    opts "$@"
    if [ "$JSON" = 1 ]; then
        if read_calls; then status_json status "$(date +%s)" true; else status_json status "$(date +%s)" false; exit 1; fi
        exit 0
    fi
    echo "call:     $(at 'AT+CLCC' 8 | tr '\n' ' ' | mask)"
    if find_card; then
        echo "scene:    $(scene_running && echo "running, output $(cat "$TMP/output")" || echo "not running") (hw:$card,$VOICE)"
        echo "playback: $PLAY (FE_ST_VOICE_PCM_P)"
        echo "capture:  $CAP (FE_ST_VOICE_C)"
    else
        echo "scene:    no sound card (mu300-audio-dsp load)"
    fi
    echo "headset:  ${BT_HEADSET:-none set in $CONF}$(hfp_up && echo ', connected')"
    echo "events:   $FEED$([ -S "$SOCK" ] && echo ", $SOCK")$(watch_up || echo ' (mu300-voice watch is not running)')"
    mu300-audio-dsp status 2>/dev/null | sed -n 's/^dsp:/dsp:     /p' ;;

call)
    opts "$@"
    api_only
    valid_number "$ARG" || result call false "not a number: 3 to 20 digits, a leading + allowed"
    load_conf   # as it is now, not as it was when this started
    call_allowed "$ARG" || result call false "not in CALL_ALLOW (voice.conf)"
    is_emergency "$ARG"
    case $? in
        1) ;;
        2) result call false "the emergency lists could not be read from the modem; not calling" ;;
        *) result call false "emergency numbers are not placed through mu300-voice" ;;
    esac
    r=$(at "ATD$ARG;" 20)
    printf '%s\n' "$r" | grep -q '^OK' || result call false "$(modem_error "$r")"
    # the new call's id: the newest outgoing call that is being set up
    id=
    if read_calls; then
        id=$(printf '%s\n' "$calls" | awk '$2 == "out" && ($3 == "dialing" || $3 == "alerting" || $3 == "active") { i = $1 } END { print i }')
    fi
    result call true "" "$([ -n "$id" ] && echo ",\"id\":$id")"
    if [ "$DEMO" = 1 ]; then
        need_card
        sleep 5
        in_call || { echo "mu300-voice: the call did not connect" >&2; exit 1; }
        audio_start dsp
        demo 5
    fi ;;

answer)
    opts "$@"
    api_only
    [ -z "$ARG" ] || is_id "$ARG" || result answer false "not a call id (1-9)"
    end=$(( $(date +%s) + ${WAIT:-0} ))
    [ -n "$WAIT" ] && [ "$JSON" = 0 ] && echo "waiting up to ${WAIT}s for a call..." >&2
    pick=
    while :; do
        if read_calls; then
            pick=$(printf '%s\n' "$calls" | awk -v want="$ARG" '
                ($3 == "incoming" || $3 == "waiting") && (want == "" || $1 == want) {
                    if ($3 == "incoming" && inc == "") inc = $1 " " $3; else if (wai == "") wai = $1 " " $3 }
                END { print (inc != "" ? inc : wai) }')
        elif [ -z "$WAIT" ]; then
            result answer false "no answer from the modem"
        fi
        [ -n "$pick" ] && break
        [ "$(date +%s)" -ge "$end" ] && result answer false "no incoming call"
        sleep 1
    done
    id=${pick% *}
    log "answering call $id (${pick#* })"
    # a waiting call is taken with the active one put on hold (AT+CHLD=2); the incoming one with ATA
    if [ "${pick#* }" = waiting ]; then r=$(at 'AT+CHLD=2' 15); else r=$(at 'ATA' 15); fi
    printf '%s\n' "$r" | grep -q '^OK' || result answer false "$(modem_error "$r")" ",\"id\":$id"
    result answer true "" ",\"id\":$id"
    if [ "$DEMO" = 1 ]; then
        need_card
        sleep 2
        in_call || { echo "mu300-voice: the call did not connect" >&2; exit 1; }
        audio_start dsp
        demo 5
    fi ;;

hangup)
    opts "$@"
    if [ -n "$ARG" ]; then
        is_id "$ARG" || result hangup false "not a call id (1-9)"
        # release that call alone (3GPP 27.007 +CHLD=1x)
        r=$(at "AT+CHLD=1$ARG" 10)
    else
        r=$(at 'AT+CHUP' 10)
    fi
    printf '%s\n' "$r" | grep -q '^OK' || result hangup false "$(modem_error "$r")"
    audio_after_hangup
    result hangup true "" "$([ -n "$ARG" ] && echo ",\"id\":$ARG")" ;;

dtmf)
    opts "$@"
    case $ARG in ''|*[!0-9*#ABCDabcd]*) result dtmf false "not DTMF: 0-9 * # A-D only" ;; esac
    [ ${#ARG} -le 32 ] || result dtmf false "at most 32 tones at a time"
    d=$ARG; sent=0
    while [ -n "$d" ]; do
        c=${d%"${d#?}"}; d=${d#?}
        case $c in a) c=A ;; b) c=B ;; c) c=C ;; d) c=D ;; esac
        # exactly one of these, checked as it is sent
        case $c in [0-9]|'*'|'#'|A|B|C|D) ;; *) result dtmf false "not DTMF: 0-9 * # A-D only" ",\"sent\":$sent" ;; esac
        r=$(at "AT+VTS=$c" 5)
        printf '%s\n' "$r" | grep -q '^OK' || result dtmf false "$(modem_error "$r")" ",\"sent\":$sent"
        sent=$((sent + 1))
    done
    result dtmf true "" ",\"sent\":$sent" ;;

demo)   need_card; demo "${1:-5}" ;;
tone)   need_card; scene_running || audio_start dsp; tone "${1:-1}" ;;
echo)   need_card; scene_running || audio_start dsp; echo_loop "${1:-5}" ;;

*) usage ;;
esac
