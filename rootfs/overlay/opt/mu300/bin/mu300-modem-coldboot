#!/bin/sh
# Stock U30 Air charger boot: PM is alive, NR/CH were not loaded by LK.
# Only a verified RAM copy loads CP|CH (34), leaving PM untouched. No AT or NV.
set -eu
export PATH="$PATH:/opt/mu300/busybox-bin"
BIN=${MU300_BIN:-/opt/mu300/bin}
R=${MU300_SYSROOT:-}
A=${1:?Android root required}
args=${2:?vendor command line required}
original=/vendor/bin/modem_control
normal() { echo "$original"; exit 0; }
[ "$("$BIN/mu300-device")" = u30air ] || normal
grep -Eq '(^|[[:space:]])(sprdboot|androidboot)\.mode=charger([[:space:]]|$)' "$args" || normal
grep -Eq '(^|[[:space:]])modem=shutdown([[:space:]]|$)' "$args" || {
    echo 'unexpected charger modem state; refusing selective load' >&2; exit 1;
}
# spipe_open() immediately returns ENODEV if its SBUF is not ready, regardless
# of O_NONBLOCK. count=0 opens/closes but does not read/write the AT channel.
# This runs before the AT owners; never use it as a runtime recovery probe.
if probe=$(LC_ALL=C dd if="$R/dev/stty_nr1" of=/dev/null count=0 2>&1); then
    normal
fi
case "$probe" in
    *'No such device'*|*'No such file or directory'*) ;;
    *) echo "cannot establish CP offline: $probe" >&2; exit 1 ;;
esac
source=$A/vendor/bin/modem_control
expected=43a3bc8c4730b87431d4fc8d90a3652b2458ef8bc9f59772685d4016cc7819a3
patched=9e3490f222a312e649dd5273df216b87ca9880a621ea68a0a73df0aa6b37c2ae
hash=$(sha256sum "$source")
[ "${hash%% *}" = "$expected" ] || { echo "unsupported U30 Air modem_control: ${hash%% *}" >&2; exit 1; }
stage=$R/run/mu300/coldboot
target=$A/tmp/mu300-coldboot
[ ! -L "$stage" ] && [ ! -L "$target" ] || exit 1
mkdir -p "$stage" "$target"
chmod 0755 "$stage" "$target"
temp=$(mktemp "$stage/.loader.XXXXXX")
trap 'rm -f "$temp"' EXIT HUP INT TERM
cp "$source" "$temp"
# VA=file offset: 0xcf0c mov w19,w0 -> mov w19,wzr; ignore PM-only boot predicate.
# 0xcf50 mov w0,63 -> mov w0,34; LOAD_CP|LOAD_CH, without stop/load PM bits.
printf '\363\003\037\052' | dd of="$temp" bs=1 seek=53004 count=4 conv=notrunc 2>/dev/null
printf '\100\004\200\122' | dd of="$temp" bs=1 seek=53072 count=4 conv=notrunc 2>/dev/null
hash=$(sha256sum "$temp")
[ "${hash%% *}" = "$patched" ] || { echo 'selective loader verification failed' >&2; exit 1; }
chmod 0755 "$temp"
mv "$temp" "$stage/modem_control"
mountpoint -q "$target" || mount --bind "$stage" "$target"
echo /tmp/mu300-coldboot/modem_control
