+/* SOC may not have been read since the last dashboard visit. Sample the
+ * live coulomb counter before reset, while the PMIC transport is still up.
+ * The retained SET/CLEAR registers are strobes: equal readback must not skip
+ * a write, hence regmap_write_bits() in the save helpers above.
+ */
+static void sc27xx_fgu_shutdown(struct platform_device *pdev)
+{
+	struct sc27xx_fgu_data *data = platform_get_drvdata(pdev);
+	int cap, ret;
+
+	if (data->var != &ump9620_info || !data->bat_present)
+		return;
+
+	mutex_lock(&data->lock);
+	ret = sc27xx_fgu_get_capacity(data, &cap);
+	if (!ret)
+		ret = sc27xx_fgu_save_last_cap(data, cap);
+	if (!ret)
+		ret = sc27xx_fgu_save_boot_mode(data, SC27XX_FGU_NORMAIL_POWERTON);
+	mutex_unlock(&data->lock);
+	if (ret)
+		dev_warn(data->dev, "failed to retain shutdown capacity: %d\n", ret);
+}
+
 static const struct dev_pm_ops sc27xx_fgu_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(sc27xx_fgu_suspend, sc27xx_fgu_resume)
 };
