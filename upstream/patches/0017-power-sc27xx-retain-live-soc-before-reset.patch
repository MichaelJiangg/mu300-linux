+	ret = regmap_write_bits(data->regmap,
 				 data->base + SC27XX_FGU_USER_AREA_CLEAR,
 				 SC27XX_FGU_MODE_AREA_MASK,
 				 SC27XX_FGU_MODE_AREA_MASK);
@@ -248,7 +248,7 @@
