+/* Electrical full thresholds come from this board's stock battery node.
+ * An arbitrary OCV percentage must not turn a partly charged cell into 100%. */
+static bool ump9620_fgu_full_qualified(struct sc27xx_fgu_data *data)
+{
+	int voltage_mv, current_ma;
+
+	if (!data->full_voltage_uv || !data->full_current_ua)
+		return false;
+	if (sc27xx_fgu_get_vbat_vol(data, &voltage_mv) ||
+	    sc27xx_fgu_get_current(data, &current_ma))
+		return false;
+	return voltage_mv >= DIV_ROUND_UP(data->full_voltage_uv, 1000) &&
+	       current_ma >= 0 && current_ma <= data->full_current_ua / 1000;
+}
