+/* The DT's otg-vbus regulator. Data-host does not imply power-source. */
+static int bq2560x_otg_enable(struct regulator_dev *rdev)
+{
+	struct bq256xx_device *bq = rdev_get_drvdata(rdev);
+	int ret;
+
+	mutex_lock(&bq->lock);
+	ret = regmap_update_bits(bq->regmap, BQ256XX_CHARGER_CONTROL_0,
+		BQ256XX_OTG_CONFIG | BQ256XX_CHG_CONFIG_MASK, BQ256XX_OTG_CONFIG);
+	mutex_unlock(&bq->lock);
+	return ret;
+}
+
+static int bq2560x_otg_disable(struct regulator_dev *rdev)
+{
+	struct bq256xx_device *bq = rdev_get_drvdata(rdev);
+	int ret;
+
+	mutex_lock(&bq->lock);
+	ret = regmap_update_bits(bq->regmap, BQ256XX_CHARGER_CONTROL_0,
+		BQ256XX_OTG_CONFIG | BQ256XX_CHG_CONFIG_MASK,
+		READ_ONCE(bq->chg_off) ? 0 : BQ256XX_CHG_CONFIG_MASK);
+	mutex_unlock(&bq->lock);
+	if (!ret)
+		mod_delayed_work(system_power_efficient_wq, &bq->vbus_work, 0);
+	return ret;
+}
+
+static int bq2560x_otg_enabled(struct regulator_dev *rdev)
+{
+	struct bq256xx_device *bq = rdev_get_drvdata(rdev);
+	unsigned int value;
+	int ret = regmap_read(bq->regmap, BQ256XX_CHARGER_CONTROL_0, &value);
+
+	return ret ? ret : !!(value & BQ256XX_OTG_CONFIG);
+}
+
+static const struct regulator_ops bq2560x_otg_ops = {
+	.enable = bq2560x_otg_enable,
+	.disable = bq2560x_otg_disable,
+	.is_enabled = bq2560x_otg_enabled,
+};
+
+static const struct regulator_desc bq2560x_otg_desc = {
+	.name = "otg-vbus", .of_match = "otg-vbus",
+	.type = REGULATOR_VOLTAGE, .owner = THIS_MODULE,
+	.ops = &bq2560x_otg_ops, .n_voltages = 1, .fixed_uV = 5000000,
+};
+
+static int bq2560x_register_otg(struct bq256xx_device *bq)
+{
+	struct regulator_config config = {
+		.dev = bq->dev, .driver_data = bq, .regmap = bq->regmap,
+	};
+	struct regulator_dev *rdev;
+
+	rdev = devm_regulator_register(bq->dev, &bq2560x_otg_desc, &config);
+	return PTR_ERR_OR_ZERO(rdev);
 }
 
 static int bq256xx_probe(struct i2c_client *client)
