#!/bin/sh
# Event-driven reconciliation for state changes that are not owned by
# mobile-data. No fixed startup sleeps: hostapd/netifd readiness drives it.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

wifi_state() {
    if ubus call hostapd.wlan0 get_status 2>/dev/null | grep -q '"status": "ENABLED"'; then
        led-status wifi-on
    else
        led-status wifi-off
    fi
}

network_state() {
    if ubus call network.interface.wan status 2>/dev/null | grep -q '"up": true'; then
        if [ "$(mu300-device 2>/dev/null)" = u30air ]; then
            # Native U30 runtime selection can differ from its next-boot
            # preference. Use the same slot/broker mapping as the dialer.
            . "${MU300_SIM_ENV_LIB:-/opt/mu300/bin/mu300-sim-env}"
            . "${MU300_NETWORK_LED_LIB:-/opt/mu300/lib/network-led.sh}"
            mu300_sim_env "" || return
            snapshot=$(MU300_AT_DIR=$MU300_SIM_SHARED mu300-at -t 3 "AT+SPACTCARD=$MU300_SIM_SLOT;+CEREG?;+C5GREG?" 2>/dev/null) || true
            state=$(printf '%s\n' "$snapshot" | mu300_network_led_state) || return
            led-status "$state"
            return
        fi
        case "$(led-status current 2>/dev/null)" in
            online-4g) led-status online-4g; return ;;
            online-5g) led-status online-5g; return ;;
        esac
        # View the selected data stack, not slot 0 unconditionally.
        slot=$(uci -q get unisoc_modem.main.data_sim); [ "$slot" = 1 ] || slot=0
        dir=/run/mu300-at; [ "$slot" != 1 ] || dir=/run/mu300-at4
        act=$(MU300_AT_DIR=$dir mu300-at -t 3 "AT+SPACTCARD=$slot;+CEREG?" 2>/dev/null | grep '+CEREG:' | head -1 | awk -F, '{print $NF}' | tr -d '" ')
        case "$act" in
            11|12|13|15) led-status online-5g ;;
            *)           led-status online-4g ;;
        esac
    else
        led-status offline
    fi
}

network_state
wifi_state
[ ! -d /sys/class/leds/v50:net1:white ] || /opt/mu300/bin/v50-led-status sync
ubus listen 2>/dev/null | while IFS= read -r event; do
    case "$event" in
        *network.interface*) network_state ;;
        *network.wireless*|*hostapd*) wifi_state ;;
    esac
done
