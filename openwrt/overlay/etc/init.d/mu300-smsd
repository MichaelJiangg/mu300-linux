#!/bin/sh /etc/rc.common
# keep the local SMS pool in step with the SIM (see /opt/mu300/bin/mu300-smsd)
START=95
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	[ -c /dev/stty_nr1 ] || return 0
	procd_open_instance smsd
	procd_set_param command /opt/mu300/bin/mu300-smsd
	# /var is tmpfs on OpenWrt; the pool is small and worth keeping across reboots
	procd_set_param env MU300_SMS_POOL=/etc/mu300/sms MU300_SIM_SLOT=0
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	if [ "$(uci -q get unisoc_modem.main.sim_slots)" = 2 ]; then
		procd_open_instance smsd-sim1
		procd_set_param command /opt/mu300/bin/mu300-smsd
		procd_set_param env MU300_SMS_POOL=/etc/mu300/sms/sim1 MU300_AT_DIR=/run/mu300-at4 MU300_SIM_SLOT=1 MU300_SMS_LOCK=/run/mu300-smsd-sim1.lock MU300_SMS_OP_LOCK=/tmp/mu300-sms-op-sim1.lock MU300_SMS_DIRECT_FLAG=/run/mu300-sms-direct-sim1
		procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
