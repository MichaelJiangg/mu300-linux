#!/bin/sh /etc/rc.common
# Passive registration cache/ubus events; no AT polling or radio resets.
START=21
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /opt/mu300/bin/mu300-network-recovery
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
