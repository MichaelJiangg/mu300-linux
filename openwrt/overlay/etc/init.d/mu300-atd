#!/bin/sh /etc/rc.common
# Keep the modem's AT channels open (closing a SIPC tty wedges it; see mu300-atd).
#
# The vendor RIL opens three channels per SIM slot (socket_id*3 .. socket_id*3+2):
#   nr0/nr1/nr2 = slot 0 group, nr3/nr4/nr5 = slot 1 group, nr31 = engpc.
# Within a group the %3==1 channel (nr1) is the handshake channel (AT+SMMSWAP=0).
# We mirror this: nr1 stays the general-purpose command channel (mu300-at,
# toolkit, diagnostics), and nr2 - the same slot 0 group's third channel - is
# dedicated to mobile-data. During AT+CGDATA's 10-20 s wait on nr2, nr1 stays
# free for signal checks, SMS and everything else.
#
# START=19, not 91. The wan protocol (S20network) dials through mobile-data, and every AT command of
# that dial goes through mu300-at -> one of these daemons. At 91 the daemon did not exist yet while
# netifd ran the first attach, so mu300-at fell back to opening /dev/stty_nr1 directly - and that
# fallback "works once, and then the channel needs a modem restart" (see mu300-at). Then the daemon
# opened the same channel again. Two readers on one SIPC tty is exactly the failure both files warn
# about, so the order was not just slow, it was the wrong side of a documented hazard.
# (V50 开机提速研究实测，见 01-逐文件改动说明.md)
START=19
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"
. "${MU300_SMS_POOL_LIB:-/opt/mu300/lib/sms-pool.sh}" || exit 1

# wait for a SIPC tty inside the procd command: the nodes appear when the CP is alive, and an init
# script that returns without opening an instance never gets a second chance. Bounded (240 s) so a
# kernel without the modem stack says so instead of spinning silently - procd respawns and retries.
wait_and_exec() {
	# $1 = tty node, $2.. = the daemon and its env is set by the caller
	local dev=$1; shift
    local ready="[ -c $dev ]"
    if [ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ]; then
        ready="$ready && [ -c /dev/sipc_sbuf ] && grep -q '^sbuf_5_006, state: 1,' /dev/sipc_sbuf"
    fi
    echo "n=0; until $ready; do n=\$((n+1)); if [ \"\$n\" -gt 240 ]; then echo 'mu300-atd: $dev never appeared' >&2; exit 1; fi; sleep 1; done; exec $*"
}

start_legacy() {
    local sms_pool=$(mu300_sms_pool)
    if [ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ]; then
        mkdir -p /run/mu300
        : > /run/mu300/u30-native
        # The missing-policy-library path must also pin SIM1, regardless of
        # an old saved SIM2 preference. No fallback may dial an unprepared RF.
        [ -s /run/mu300/sim-slot ] || printf '0\n' > /run/mu300/sim-slot
    fi
	# Do not migrate NR3 ownership after daemons have opened the SIPC ttys.
	[ ! -x /opt/mu300/bin/mu300-platform-config ] || /opt/mu300/bin/mu300-platform-config
	# Optional plugin handshake: reserve nr1's first-command window for the
	# platform radio-on path. The generic worker waits for this marker to clear.
	[ ! -x /usr/libexec/unisoc-modem/lock ] || : > /run/unisoc-modem-early-hook-pending
	[ -x /opt/mu300/bin/bootmark ] && /opt/mu300/bin/bootmark S19-atd-init
	procd_open_instance atd
	procd_set_param env MU300_AT_DISABLE_REOPEN="$([ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] && echo 1 || echo 0)" MU300_SMS_POOL="$sms_pool"
	procd_set_param command /bin/sh -c "$(wait_and_exec /dev/stty_nr1 /opt/mu300/bin/mu300-atd)"
	[ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] || procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# second instance on nr2 (mobile-data's dedicated channel)
	procd_open_instance atd2
	procd_set_param command /bin/sh -c "$(wait_and_exec /dev/stty_nr2 /opt/mu300/bin/mu300-atd)"
	procd_set_param env MU300_AT_DISABLE_REOPEN="$([ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] && echo 1 || echo 0)" MU300_SMS_POOL="$sms_pool" MU300_AT_DEV=/dev/stty_nr2 MU300_AT_DIR=/run/mu300-at2 MU300_AT_URC_CHANNELS= MU300_AT_ALIVE_LOG=/run/mu300-at/urc/stty_nr0.log
	[ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] || procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Keep slot 1's nr3/nr4/nr5 open like the vendor RIL does. The optional
	# nr6/nr7 channels are the bounded slot-0 dashboard pool; all descriptors
	# remain open for the life of the boot so failover never requires a reopen.
	local n urc pool alive_log
	for n in 3 4 5 6 7; do
		# NR3 is the slot-1 URC stream, not an extra command reader. Ownership
		# changes only at boot: never restart atd to enable this on a live CP.
		[ "$n" != 3 ] || [ "$(uci -q get unisoc_modem.main.sim_slots)" != 2 ] || continue
		procd_open_instance atd$n
		procd_set_param command /bin/sh -c "$(wait_and_exec /dev/stty_nr$n /opt/mu300/bin/mu300-atd)"
		urc= pool=$sms_pool alive_log=/run/mu300-at/urc/stty_nr0.log
		case "$n" in 3|4|5)
			pool=$sms_pool/sim1
			if [ "$n" = 4 ] && [ "$(uci -q get unisoc_modem.main.sim_slots)" = 2 ]; then
				urc=3 alive_log=/run/mu300-at4/urc/stty_nr3.log
			fi ;;
		esac
		# Set the env table ONCE. Adding another table with the same JSON key
		# can leave procd with only MU300_AT_DEV and the wrong owner directory.
		procd_set_param env MU300_AT_DISABLE_REOPEN="$([ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] && echo 1 || echo 0)" MU300_AT_DEV=/dev/stty_nr$n MU300_AT_DIR=/run/mu300-at$n MU300_AT_URC_CHANNELS=$urc "MU300_SMS_POOL=$pool" MU300_AT_ALIVE_LOG=$alive_log
		[ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] || procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done

	# Turn the radio on as soon as nr1's persistent daemon is ready, in a
	# separate procd process. This overlaps the remaining rc scripts and leaves
	# PDP activation to netifd. The FIFO is the readiness event; mobile-data's
	# radio lock excludes a simultaneous dial-up state machine.
	procd_open_instance radio-warmup
	procd_set_param command /bin/sh -c 'n=0; until [ -p /run/mu300-at/cmd ]; do n=$((n+1)); [ "$n" -gt 90 ] && exit 1; sleep 1; done; exec /opt/mu300/bin/mobile-data radio-on'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# broker NAME CHANNEL DIR URC-CHANNELS LIVE-URC-LOG [WAIT]: one persistent owner of a SIPC tty. WAIT is a shell
# condition the instance waits for (bounded) before it opens the channel: the second group's channels have a node
# before the CP is up, and spipe_open returns ENODEV until the sbuf is READY, which the driver's seqfile shows.
# The wait is inside the instance, never in start_service: an init script that waits returns without instances
# when the wait fails, and a boot without AT brokers is a boot without WAN.
broker() {
    local name=$1 channel=$2 directory=$3 urc=$4 live=$5 wait=${6:-} condition= pool=$(mu300_sms_pool)
    [ "$channel" -lt 3 ] || pool=$pool/sim1
    # A literal brace inside ${...:+...} closes the expansion early in ash. Build it separately.
    [ -z "$wait" ] || condition=" && { $wait; }"
    procd_open_instance "$name"
    procd_set_param command /bin/sh -c "n=0; until [ -c /dev/stty_nr$channel ]$condition; do n=\$((n+1)); [ \"\$n\" -gt 240 ] && { echo 'mu300-atd: /dev/stty_nr$channel never became ready' >&2; exit 1; }; sleep 1; done; exec /opt/mu300/bin/mu300-atd"
    procd_set_param env "MU300_AT_DEV=/dev/stty_nr$channel" "MU300_AT_DIR=$directory" \
        "MU300_AT_URC_CHANNELS=$urc" "MU300_AT_ALIVE_LOG=$live" "MU300_SMS_POOL=$pool" \
        MU300_AT_DISABLE_REOPEN=1
    # A failed owner stays failed during this boot (no respawn): restarting it would reopen a SIPC channel, and
    # the cold start / the switch refuse to run without all four owners rather than talk to a reopened one.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

SBUF_READY="[ -c /dev/sipc_sbuf ] && grep -q '^sbuf_5_006, state: 1,' /dev/sipc_sbuf"
start_sim2() {
    mkdir -p /run/mu300
    [ ! -x /usr/libexec/unisoc-modem/lock ] || : > /run/unisoc-modem-early-hook-pending
    # Before S20network or any radio-warmup process: inhibit automatic SIM1 bring-up for this entire boot.
    : > /run/mu300-radio-freeze
    : > /run/mu300/sim-active-unknown
    [ "$hot" != 1 ] || : > /run/mu300/sim-managed
    broker atd 1 /run/mu300-at 0 /run/mu300-at/urc/stty_nr0.log "$SBUF_READY"
    broker atd2 2 /run/mu300-at2 '' /run/mu300-at/urc/stty_nr0.log "$SBUF_READY"
    broker atd4 4 /run/mu300-at4 3 /run/mu300-at4/urc/stty_nr3.log "$SBUF_READY"
    broker atd5 5 /run/mu300-at5 '' /run/mu300-at4/urc/stty_nr3.log "$SBUF_READY"
    # The cold start (and its fallback to SIM1 when it cannot be done): mu300-sim2-warmup confirms the boot.
    procd_open_instance sim2-cold-start
    procd_set_param command /bin/bash /opt/mu300/bin/mu300-sim2-warmup
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# sim_fallback REASON: back to SIM1 without live switching, the reason kept for the Dual SIM page (mu300-sim status).
# It never fails its caller: settings that cannot be written (a full or read-only filesystem) leave the pending
# marker, and the caller makes this boot a SIM1 boot either way.
sim_fallback() {
    echo "mu300-atd: dual SIM: $1; SIM1 without live switching from now on" >&2
    printf '%s\n' "$1" > /etc/mu300-sim-fallback 2>/dev/null
    sim_cfg_save_default 0 && sim_cfg_save_hot 0 && rm -f /etc/mu300-sim-pending
    return 0
}
# sim1_only: this boot is a plain SIM1 boot, whatever was chosen. The pin says so to every reader (mu300-sim active):
# without it start_legacy would take a saved second card for the F50's kind and open nr4/nr5 under SIM1's names.
sim1_only() {
    mkdir -p /run/mu300
    printf '0\n' > /run/mu300/sim-slot
    start_legacy
}

# Every path through here ends with AT owners started: a return without instances is a boot without modem control,
# and nothing starts this service a second time. Whatever cannot be read, written or understood is a SIM1 boot.
start_service() {
    [ ! -x /opt/mu300/bin/mu300-platform-config ] || /opt/mu300/bin/mu300-platform-config
    local slot hot temporary lib=${MU300_SIM_CONFIG_LIB:-/opt/mu300/lib/sim-config.sh}
    # Only the U30 Air has the second group and the validated sequences; everywhere else the files are ignored.
    [ "$(/opt/mu300/bin/mu300-device 2>/dev/null)" = u30air ] || { start_legacy; return; }
    [ -r "$lib" ] || { start_legacy; return; }
    mkdir -p /run/mu300
    : > /run/mu300/u30-native
    SIM_CONFIG_U30=1
    . "$lib"
    mkdir -p /run/mu300
    # mu300-sim2-warmup gave the dual-SIM start up in this boot and started the service over: SIM1, nothing else
    [ ! -e /run/mu300/sim-fallback-boot ] || { sim1_only; return; }
    sim_cfg_migrate || sim_fallback invalid-settings
    slot=$(cat /run/mu300/sim-slot 2>/dev/null || sim_cfg_default) || slot=invalid
    hot=$(sim_cfg_hot) || hot=invalid
    case "$hot" in 0|1) ;; *) sim_fallback invalid-hot; slot=0; hot=0;; esac
    case "$slot" in 0|1) ;; *) sim_fallback invalid-slot; slot=0; hot=0 ;; esac
    # One boot at a time: the dual-SIM path leaves a pending marker that mu300-sim2-warmup removes once the radio
    # is up (or it falls back itself). A marker still there at the next boot means that boot never confirmed
    # (a broker that never came up, a warm-up that died): this boot is a plain SIM1 boot, and the page says why.
    if [ ! -e /run/mu300/sim-boot-policy ] && [ -e /etc/mu300-sim-pending ]; then
        sim_fallback unconfirmed
        : > /run/mu300/sim-boot-policy
        sim1_only; return
    fi
    : > /run/mu300/sim-boot-policy
    # Pin the active slot for this boot; changing network.wan.sim_slot only affects the next boot.
    if [ ! -e /run/mu300/sim-slot ]; then
        temporary=$(mktemp /run/mu300/sim-slot.XXXXXX) || { sim1_only; return; }
        printf '%s\n' "$slot" > "$temporary"
        ln "$temporary" /run/mu300/sim-slot 2>/dev/null
        rm -f "$temporary"
    fi
    slot=$(cat /run/mu300/sim-slot 2>/dev/null) || slot=invalid
    case "$slot:$hot" in
        0:0) start_legacy ;;
        0:1|1:[01])
            # The dual-SIM path's helpers are bash, and its one-boot guarantee needs the marker on the disk: without
            # either this is a SIM1 boot, and the settings go back so that the next one does not try again.
            if command -v bash >/dev/null 2>&1 && touch /etc/mu300-sim-pending 2>/dev/null; then
                start_sim2
            else
                sim_fallback not-startable
                sim1_only
            fi ;;
        *) echo "mu300-atd: invalid SIM slot $slot; SIM1" >&2; sim1_only ;;
    esac
}
