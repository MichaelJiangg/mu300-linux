#!/bin/sh /etc/rc.common
# Voice calls: events, hooks and call audio (mu300-voice watch; docs/voice-api.md).
# Not enabled in the image: it asks the modem about calls every few seconds, which only a device that takes calls
# needs. "/etc/init.d/mu300-voice enable && /etc/init.d/mu300-voice start" turns it on.
# After mu300-atd (19): every question goes through its daemon.
START=95
USE_PROCD=1

start_service() {
	procd_open_instance watch
	procd_set_param command /opt/mu300/bin/mu300-voice watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
