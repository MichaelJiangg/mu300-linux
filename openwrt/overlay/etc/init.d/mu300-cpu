#!/bin/sh /etc/rc.common
# apply the CPU performance profile saved by mu300-cpu (/etc/mu300/cpu.conf), with the services' CPUs (mu300-cpu
# services, FINDINGS 235: every CPU unless "little" was chosen)
START=95

start() {
	if [ -r /etc/mu300/cpu.conf ]; then
		/opt/mu300/bin/mu300-cpu apply
	else
		/opt/mu300/bin/mu300-cpu services apply
	fi
}
