#!/bin/sh /etc/rc.common
START=96
STOP=01
USE_PROCD=1

start_service() {
    local adapter devices
    adapter=$(uci -q get unisoc_modem.main.data_sim_command)
    adapter=${adapter:-/opt/mu300/bin/mu300-data-sim}
    if [ "$(uci -q get unisoc_modem.main.sim_slots)" = 2 ] && [ -x "$adapter" ]; then
        devices=$("$adapter" get | jsonfilter -e '@.devices' 2>/dev/null)
    fi
    procd_open_instance
    procd_set_param command /usr/bin/ucode -g 1000 /usr/libexec/unisoc-modem/traffic
    procd_set_param env "MU300_TRAFFIC_DEVICES=${devices:-[]}"
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 8
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger unisoc_modem
}

stop_service() {
    ubus -t 3 call unisoc.traffic flush >/dev/null 2>&1 || true
}
