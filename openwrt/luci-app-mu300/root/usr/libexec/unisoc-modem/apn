#!/usr/bin/ucode
import * as fs from 'fs';
import { cursor } from 'uci';
import { connect, error } from 'ubus';
import * as apn from './apn.uc';
let action=ARGV[0] || 'get', c=cursor(), result;
let slot=c.get('unisoc_modem','main','data_sim')=='1'?'1':'0';
function cachedIdentity() {
    try{return json(fs.readfile('/run/unisoc-apn-sim'+slot+'.json') || '{}');}catch(e){return {};}
}
if(action=='resolve') {
    // Private platform interface: credentials are never exposed by rpcd.
    let p=json(fs.readfile('/dev/stdin') || '{}');
    let iface=c.get('unisoc_modem','main','data_interface') || 'wan';
    result=apn.resolve(c,p,c.get_all('network',iface) || {});
} else if(action=='status') {
    result=apn.status(c,cachedIdentity());
} else if(action=='needs-identity') {
    let needed=false;c.foreach('unisoc_apn','selection',()=>{needed=true;});
    print(needed?'1\n':'0\n');exit(0);
} else if(action=='get') {
    result=apn.get(c,cachedIdentity());
    try {result.dial=json(fs.readfile('/run/unisoc-apn-dial-'+slot+'.json') || '{}');}catch(e){}
    let bus=connect(null,2), status=bus?.call('network.interface.'+result.iface,'status',{});
    result.connected=status?.up===true;result.connecting=status?.pending===true;
}
else {
    // Share the existing SIM-switch gate: an APN transaction must not commit
    // half-way through changing the data card. Boot replay uses a separate lock.
    const lock='/run/unisoc-data-sim-switch';
    let acquired=fs.mkdir(lock,448);
    if(!acquired) {
        let pid=trim(fs.readfile(lock+'/pid') || '');
        if(match(pid,/^[1-9][0-9]*$/) && !fs.stat('/proc/'+pid)) {
            fs.unlink(lock+'/pid');fs.rmdir(lock);acquired=fs.mkdir(lock,448);
        }
    }
    if(!acquired) result={ok:0,error:'apn_busy'};
    else {
        fs.writefile(lock+'/pid',''+fs.readlink('/proc/self'));
        try {
            let payload=fs.readfile('/dev/stdin');
            if(length(payload || '')>4096)die('request too large');
            if(fs.stat('/run/unisoc-modem-lock-apply'))
                result={ok:0,error:'apn_busy'};
            else {
              let p=json(payload || '{}'), identity=cachedIdentity();
              if(action=='auto' || (action=='apply' && p.remember===true)) {
                let pipe=fs.popen('/usr/libexec/unisoc-modem/apn-identity '+slot,'r');
                identity=json(pipe?.read('all') || '{}');pipe?.close();
              }
              result=apn.change(c,action,p,iface=>{
                let bus=connect(null,3);
                fs.writefile('/run/unisoc-apn-dial-'+slot+'.json',sprintf('%J',{phase:'queued'}));
                // netifd compares configurations and restarts only changed interfaces.
                // Do not restart network.service, USB, Wi-Fi or change the data SIM.
                // Selection lives outside network UCI. Restart this bearer
                // explicitly even when its netifd configuration is unchanged.
                return apn.reconnect(bus,error,iface);
              },identity);
              fs.chmod('/etc/config/unisoc_apn',384);
              fs.chmod('/etc/config/network',384);
            }
        } catch(e) { result={ok:0,error:'apn_invalid'}; }
        fs.unlink(lock+'/pid');fs.rmdir(lock);
    }
}
print(sprintf('%J\n',result));
