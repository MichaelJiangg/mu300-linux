MU300: bounded TX-pressure diagnostics; counters do not change queue ownership or credit limits.

--- a/drivers/unisoc_platform/sprdwcn/pcie/edma_engine.c
+++ b/drivers/unisoc_platform/sprdwcn/pcie/edma_engine.c
@@ -12,6 +12,9 @@
 
 #include <linux/delay.h>
 #include <linux/timer.h>
+#include <linux/atomic.h>
+#include <linux/moduleparam.h>
+#include <linux/ratelimit.h>
 #include <misc/marlin_platform.h>
 #include <misc/wcn_bus.h>
 #include <linux/pci.h>
@@ -39,6 +42,29 @@ static int hisrfunc_line;
 static int hisrfunc_last_msg;
 static struct edma_info g_edma = { 0 };
 
+/* A full pending queue refuses ownership; the caller must retry/free it.
+ * Keep exact rejection counts even when diagnostic messages are throttled.
+ * No timer, workqueue, hardware access or periodic logging is added.
+ */
+static atomic64_t edma_pending_full[ARRAY_SIZE(g_edma.chn_sw)];
+
+static int mu300_edma_stats_get(char *buffer, const struct kernel_param *kp)
+{
+	int i, len = 0;
+
+	for (i = 0; i < ARRAY_SIZE(edma_pending_full); i++)
+		len += scnprintf(buffer + len, PAGE_SIZE - len, "ch%d=%lld%s", i,
+			(long long)atomic64_read(&edma_pending_full[i]),
+			i == ARRAY_SIZE(edma_pending_full) - 1 ? "\n" : " ");
+	return len;
+}
+
+static const struct kernel_param_ops mu300_edma_stats_ops = {
+	.get = mu300_edma_stats_get,
+};
+module_param_cb(mu300_edma_stats, &mu300_edma_stats_ops, NULL, 0444);
+MODULE_PARM_DESC(mu300_edma_stats, "Per-channel pending-queue rejections (not packet drops)");
+
 static unsigned char *mpool_buffer;
 static struct dma_buf mpool_dm = {0};
 
@@ -1001,11 +1027,16 @@ static int edma_pending_q_buffer(int chn, void *head, void *tail, int num)
 {
 	struct edma_pending_q *q;
 	struct edma_info *edma = edma_info();
+	static DEFINE_RATELIMIT_STATE(full_rs, DEFAULT_RATELIMIT_INTERVAL, 1);
 
 	q = &(edma->chn_sw[chn].pending_q);
 
 	if ((q->wt + 1) % (q->max) == q->rd) {
-		pr_warn_ratelimited("WARN %s(%d) full\n", __func__, chn);
+		atomic64_inc(&edma_pending_full[chn]);
+		if (__ratelimit(&full_rs))
+			pr_warn("WARN %s(%d) full (rejected submissions=%lld)\n",
+				__func__, chn,
+				(long long)atomic64_read(&edma_pending_full[chn]));
 		return ERROR;
 	}
 	q->ring[q->wt].head = head;
